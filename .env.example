# Copy to .env and fill in, or export these before `npm start`.
# The bridge itself does not read .env — your shell / process manager must.

# --- upstream (pick one) -----------------------------------------------------
# 1) Any OpenAI-compatible endpoint (DeepSeek, OpenAI, Ollama, vLLM, LM Studio …)
WB_UPSTREAM=openai
WB_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
WB_UPSTREAM_API_KEY=sk-replace-me

# 2) The WorkBuddy desktop channel instead (needs the adapter in vendor/wb, see README)
# WB_UPSTREAM=workbuddy

# --- bridge ------------------------------------------------------------------
WB_BRIDGE_HOST=127.0.0.1
WB_BRIDGE_PORT=8787
WB_BRIDGE_TOKEN=wb-local

# Rewrite every request's model id. Leave empty (or "auto") to pass the client's model through.
WB_BRIDGE_MODEL=

# Optional: also accept the key stored in a host application's provider config.
# WB_PROVIDER_CONFIG=C:\path\to\provider\config.json
